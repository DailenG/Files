<?xml version="1.0"?>
<Container version="2">
  <Name>signoz-aio</Name>
  <Repository>jsonbored/signoz-aio:latest</Repository>
  <Registry>https://hub.docker.com/r/jsonbored/signoz-aio</Registry>
  <Network>otel-net</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/JSONbored/signoz-aio/issues</Support>
  <Project>https://github.com/JSONbored/signoz-aio</Project>
  <Overview>SigNoz backend for Files Cloud Guard telemetry. OTLP ports 4317/4318 are intentionally not published; the otel-ingress container reaches them over the otel-net docker network. Deployed by ops/observability/unraid/deploy.sh in the Files fork.</Overview>
  <Category>Network:Management Tools:Utilities</Category>
  <WebUI>http://[IP]:[PORT:8080]</WebUI>
  <Icon>https://raw.githubusercontent.com/JSONbored/awesome-unraid/main/icons/signoz.png</Icon>
  <ExtraParams>--restart unless-stopped</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <Networking>
    <Mode>otel-net</Mode>
    <Publish>
      <Port>
        <HostPort>8080</HostPort>
        <ContainerPort>8080</ContainerPort>
        <Protocol>tcp</Protocol>
      </Port>
    </Publish>
  </Networking>
  <Data>
    <Volume>
      <HostDir>/mnt/user/appdata/signoz-aio</HostDir>
      <ContainerDir>/appdata</ContainerDir>
      <Mode>rw</Mode>
    </Volume>
    <Volume>
      <HostDir>/mnt/user/appdata/signoz-aio/clickhouse</HostDir>
      <ContainerDir>/var/lib/clickhouse</ContainerDir>
      <Mode>rw</Mode>
    </Volume>
  </Data>
  <Environment>
    <Variable>
      <Name>TZ</Name>
      <Value>America/New_York</Value>
    </Variable>
    <Variable>
      <Name>SIGNOZ_GLOBAL_INGESTION__URL</Name>
      <Value>https://otel.pesengineers.dev:8443</Value>
    </Variable>
    <Variable>
      <Name>SIGNOZ_ANALYTICS_ENABLED</Name>
      <Value>false</Value>
    </Variable>
    <Variable>
      <Name>SIGNOZ_STATSREPORTER_ENABLED</Name>
      <Value>false</Value>
    </Variable>
  </Environment>
  <Config Name="SigNoz UI Port" Target="8080" Default="8080" Mode="tcp" Description="SigNoz UI and API. LAN only." Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="AppData - SigNoz Root" Target="/appdata" Default="/mnt/user/appdata/signoz-aio" Mode="rw" Description="ClickHouse data, ZooKeeper state, generated config, SigNoz SQLite metadata." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/signoz-aio</Config>
  <Config Name="AppData - ClickHouse" Target="/var/lib/clickhouse" Default="/mnt/user/appdata/signoz-aio/clickhouse" Mode="rw" Description="Telemetry database. The image declares this as an anonymous VOLUME and does not write under /appdata despite upstream docs; bind it explicitly or data is orphaned on container recreate." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/signoz-aio/clickhouse</Config>
  <Config Name="Timezone" Target="TZ" Default="America/New_York" Mode="" Description="Container timezone." Type="Variable" Display="always" Required="false" Mask="false">America/New_York</Config>
  <Config Name="Ingestion URL" Target="SIGNOZ_GLOBAL_INGESTION__URL" Default="https://otel.pesengineers.dev:8443" Mode="" Description="Public ingest URL advertised in the UI; served by otel-ingress." Type="Variable" Display="always" Required="false" Mask="false">https://otel.pesengineers.dev:8443</Config>
  <Config Name="Analytics Enabled" Target="SIGNOZ_ANALYTICS_ENABLED" Default="false" Mode="" Description="Upstream Segment analytics. Keep off." Type="Variable" Display="advanced" Required="false" Mask="false">false</Config>
  <Config Name="Stats Reporter Enabled" Target="SIGNOZ_STATSREPORTER_ENABLED" Default="false" Mode="" Description="Upstream stats reporting. Keep off." Type="Variable" Display="advanced" Required="false" Mask="false">false</Config>
</Container>
