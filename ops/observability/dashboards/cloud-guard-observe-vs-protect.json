                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0,
                "softMax": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "stepInterval": 60,
                          "signal": "metrics",
                          "source": "",
                          "aggregations": [
                            {
                              "metricName": "files.cloud.operations",
                              "temporality": "",
                              "timeAggregation": "increase",
                              "spaceAggregation": "sum",
                              "reduceTo": "sum"
                            }
                          ],
                          "disabled": false,
                          "filter": {
                            "expression": "provider.kind = $provider optimization.mode in $mode access.origin = 'background'"
                          },
                          "groupBy": [
                            {
                              "name": "optimization.mode",
                              "signal": "",
                              "fieldContext": "attribute",
                              "fieldDataType": "string"
                            }
                          ],
                          "order": [],
                          "having": {
                            "expression": ""
                          },
                          "functions": [],
